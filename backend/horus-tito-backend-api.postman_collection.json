    {
      "name": "User Management",
      "item": [
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Users have correct structure\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0]).to.have.property('id');",
                  "        pm.expect(jsonData[0]).to.have.property('username');",
                  "        pm.expect(jsonData[0]).to.have.property('email');",
                  "        pm.expect(jsonData[0]).to.have.property('nama');",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Password is not exposed\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        // Check that neither the new column 'password' nor old 'password_hash' exists",
                  "        pm.expect(jsonData[0]).to.not.have.property('password');",
                  "        pm.expect(jsonData[0]).to.not.have.property('password_hash');",
                  "    }",
                  "});",
                  "",
                  "// Save first user ID for update/delete tests",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.length > 0) {",
                  "    const testUsername = pm.collectionVariables.get(\"test_username\");",
                  "    const testUser = jsonData.find(user => user.username === testUsername);",
                  "    if (testUser) {",
                  "        pm.collectionVariables.set(\"user_id\", testUser.id);",
                  "        console.log(\"✅ Test user ID saved: \" + testUser.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
