          "name": "Password Not Stored as Plain Text",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Password fields are never exposed\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(user => {",
                  "        // Check for the new column name",
                  "        pm.expect(user).to.not.have.property('password');",
                  "        // Check for the old column name (just in case)",
                  "        pm.expect(user).to.not.have.property('password_hash');",
                  "    });",
                  "    console.log(\"✅ Password security verified - no password fields in response\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
